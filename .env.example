# SoulChord Agent Runtime 环境变量（复制为 .env 并填入真实值）

# 网络
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
MUSIC_API_BASE_URL=http://localhost:8081/api/v1

# LLM（DeepSeek）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 数据目录
DATA_DIR=data

# 日志
LOG_LEVEL=INFO
